# แม่แบบ env ฝั่ง server — คัดลอกเป็น .env แล้วใส่ค่าจริง (อย่า commit .env)

# Database (Supabase PostgreSQL)
DATABASE_URL=

# JWT secret (บังคับมี — ไม่งั้น server ไม่ start)
SECRET=

# Email ใบแจ้งหนี้ (M6) — Gmail App Password (ใช้ตอน dev/local เท่านั้น)
# หมายเหตุ: Render บล็อก outbound SMTP จึงส่งผ่าน Gmail SMTP บนโปรดัคชันไม่ได้
MAIL_USER=
MAIL_PASS=

# Email ผ่าน Brevo HTTP API (ใช้บน Render — พอร์ต 443 ไม่โดนบล็อก)
# 1) สมัคร https://www.brevo.com (ฟรี 300 อีเมล/วัน)
# 2) ยืนยัน sender ที่เมนู Senders, Domains & Dedicated IPs > Senders (ใช้อีเมลเดียวกับ MAIL_FROM)
# 3) สร้าง API key ที่ SMTP & API > API Keys แล้วเอามาใส่ตรงนี้
BREVO_API_KEY=
# อีเมลผู้ส่งที่ verify แล้วใน Brevo (ถ้าเว้นว่างจะใช้ค่า MAIL_USER)
MAIL_FROM=

# Email ผ่าน Resend HTTP API — ทางเลือกที่ใช้ได้ทันทีหลังสมัคร (ไม่มีด่านรอ activation)
# 1) สมัคร https://resend.com (ล็อกอินด้วย GitHub ได้)
# 2) API Keys > Create API Key แล้วเอามาใส่ตรงนี้ (ขึ้นต้น re_...)
# ถ้ายังไม่ verify โดเมน: ส่งได้เฉพาะอีเมลเจ้าของบัญชี Resend และ from = onboarding@resend.dev
# ถ้ามีโดเมนแล้ว verify ใน Resend แล้วตั้ง RESEND_FROM = "ชื่อ <no-reply@yourdomain.com>"
RESEND_API_KEY=
RESEND_FROM=

# Email ผ่าน Mailjet HTTP API — ฟรี ส่งหาอีเมลใครก็ได้ โดย verify แค่ "อีเมลผู้ส่ง" (ไม่ต้องมีโดเมน)
# 1) สมัคร https://www.mailjet.com (ฟรี 200 อีเมล/วัน)
# 2) Account settings > Sender & Domains > เพิ่มและ verify อีเมลผู้ส่ง (ใช้ค่าเดียวกับ MAIL_FROM)
# 3) Account settings > API Key Management เอา "API Key" และ "Secret Key" มาใส่
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# PromptPay + Supabase Storage สลิป (M7)
PROMPTPAY_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Omise (Opn Payments) — ชำระด้วย QR PromptPay แบบยืนยันอัตโนมัติ
# ขอ key ได้ที่ dashboard.omise.co (โหมด test ขึ้นต้น pkey_test_ / skey_test_)
OMISE_PUBLIC_KEY="pkey_test_687i92bl9zqwvrhkxny"
OMISE_SECRET_KEY="skey_test_687i92c59mfmkfvpwt6"

# Social Login (M10c) — ดูวิธีขอใน docs/SOCIAL_LOGIN_SETUP.md
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
